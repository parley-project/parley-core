<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-core</artifactId>
	<version>1.0.0</version>
	<name>Parley Core</name>

	<description>Core components shared by the Parley protocol libraries: logging, property lookup,
		threads, TLS sockets, a base TCP/SSL server and small utilities, with a minimum of
		external dependencies. Formerly us.bringardner:bjl_core.</description>
	<inceptionYear>1998</inceptionYear>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<!-- Written to the jar manifest as Automatic-Module-Name (was us.bringardner.core) -->
		<parley.moduleName>us.bringardner.parley.core</parley.moduleName>
		<junit.version>5.11.4</junit.version>
		<log4j.version>2.24.3</log4j.version>
	</properties>

	<build>
		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
			</testResource>
			<!-- Example logging configurations (log4j2.xml, JulLogging.properties) used by the logger tests.
			     They are test resources only so they are not packaged in the library jar. -->
			<testResource>
				<directory>resources</directory>
			</testResource>
		</testResources>

		<plugins>
			<!-- Building needs JDK 21+ for src/main/java21 (the library itself runs on Java 11) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-build-jdk</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>[21,)</version>
									<message>parley-core is built with JDK 21 or later (it contains Java 21 classes in a multi-release jar). It still runs on Java 11.</message>
								</requireJavaVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!--
			  Multi-release jar: everything is compiled for Java 11; the few classes in
			  src/main/java21 are compiled for Java 21 into META-INF/versions/21, where only
			  Java 21+ JVMs look. The library still runs on Java 11; building it needs JDK 21+.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>java21</id>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<release>21</release>
							<compileSourceRoots>
								<compileSourceRoot>${project.basedir}/src/main/java21</compileSourceRoot>
							</compileSourceRoots>
							<multiReleaseOutput>true</multiReleaseOutput>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!--
			  The JVM only picks META-INF/versions/21 from inside a jar; surefire tests
			  target/classes (the Java 11 classes). Tests named *IT run in 'mvn verify' against
			  the built jar, so on JDK 21+ they test the Java 21 classes.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Sources jar attached at package (not deploy) so it exists BEFORE the deploy plugin runs.
			     The parent's release profile adds the same execution for Maven Central. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>package</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Automatic-Module-Name comes from parley-parent; Multi-Release is added here -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifestEntries>
							<!-- Java 21+ JVMs use the classes in META-INF/versions/21 -->
							<Multi-Release>true</Multi-Release>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
			<!-- Code coverage: 'mvn verify' writes the report to target/site/jacoco/index.html.
			     If an argLine is ever configured for surefire, write it as <argLine>@{argLine} ...</argLine>
			     so it does not replace the JaCoCo agent set by prepare-agent. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<!-- Attaches the JaCoCo agent to the surefire test JVM -->
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<!-- HTML, XML and CSV reports in target/site/jacoco -->
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
						<configuration>
							<!-- The Java 21 copies of multi-release classes have the same names as the
							     Java 11 ones, which the report can't hold twice -->
							<excludes>
								<exclude>META-INF/versions/**</exclude>
							</excludes>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<!-- log4j is only used for testing, Log4JLogger accesses it by reflection at runtime.
		     2.13.2 was vulnerable to Log4Shell (CVE-2021-44228). -->
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-api</artifactId>
			<version>${log4j.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-core</artifactId>
			<version>${log4j.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- junit-jupiter includes the API (to compile tests) and the engine (to run them) -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
